<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameLauncher"
        xmlns:l="clr-namespace:GameLauncher.Localization"
        Title="MyGameLauncher" MinWidth="900" MinHeight="560"
        Icon="Assets/app.ico"
        Background="#141416" Foreground="White"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:AppCommands.OpenGame}" Executed="OpenGame_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.PlayGame}" Executed="PlayGame_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.ToggleFavorite}" Executed="ToggleFavorite_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.OpenFolder}" Executed="OpenFolder_Executed"/>
        <CommandBinding Command="{x:Static local:AppCommands.OpenInStore}" Executed="OpenInStore_Executed"/>
    </Window.CommandBindings>

    <Grid x:Name="Root">
        <!-- Sombra suave de cima para baixo por cima da cor do tema -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#14000000" Offset="0.5"/>
                    <GradientStop Color="#66000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Barra lateral ================= -->
            <Border Grid.Column="0" Background="#2E000000">
                <DockPanel Margin="12,16,12,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                        <Image Source="Assets/app.png" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="AppNameText" Text="MyGameLauncher" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Click="NavSettings_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Width="26"/>
                                <TextBlock Text="{l:Tr Nav_Settings}"/>
                            </DockPanel>
                        </RadioButton>
                        <Button x:Name="FullscreenButton" Style="{StaticResource LinkButton}" Margin="2,6,0,0"
                                HorizontalAlignment="Left" Click="Fullscreen_Click" ToolTip="F11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FullscreenIcon" Text="&#xE740;" Style="{StaticResource Icon}" Width="26"/>
                                <TextBlock x:Name="FullscreenText" Text="{l:Tr Fullscreen}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Nav_Library}" Style="{StaticResource Eyebrow}" Margin="10,0,0,6"/>
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Click="NavHome_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Width="26"/>
                                    <TextBlock Text="{l:Tr Nav_Home}"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAll" Style="{StaticResource NavItem}" Click="NavAll_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" Width="26"/>
                                    <TextBlock x:Name="AllCount" DockPanel.Dock="Right" Opacity="0.6" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{l:Tr Nav_AllGames}"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFavorites" Style="{StaticResource NavItem}" Click="NavFavorites_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" Width="26"/>
                                    <TextBlock x:Name="FavCount" DockPanel.Dock="Right" Opacity="0.6" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{l:Tr Nav_Favorites}"/>
                                </DockPanel>
                            </RadioButton>

                            <TextBlock Text="{l:Tr Nav_Stores}" Style="{StaticResource Eyebrow}" Margin="10,18,0,6"/>
                            <ItemsControl x:Name="StoresList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource NavItem}" Tag="{Binding Name}" Click="NavStore_Click">
                                            <DockPanel>
                                                <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Width="26"/>
                                                <TextBlock DockPanel.Dock="Right" Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                                                           Text="{Binding Count}"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="2,2,0,0"
                                    Click="AddGame_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Width="26" FontSize="12"/>
                                    <TextBlock Text="{l:Tr Nav_AddGame}"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{l:Tr Nav_Collections}" Style="{StaticResource Eyebrow}" Margin="10,18,0,6"/>
                            <ItemsControl x:Name="CollectionsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource NavItem}" Tag="{Binding}" Click="NavCollection_Click">
                                            <DockPanel>
                                                <TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}" Width="26"/>
                                                <TextBlock DockPanel.Dock="Right" Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                                                           Text="{Binding GameIds.Count}"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="NewCollectionBox" Style="{StaticResource RoundTextBox}" Padding="12,6" Tag="{l:Tr Nav_NewCollectionHint}"
                                     Margin="0,4,0,4" Visibility="Collapsed" KeyDown="NewCollectionBox_KeyDown"
                                     LostKeyboardFocus="NewCollectionBox_LostFocus"/>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="2,2,0,0"
                                    Click="NewCollection_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Width="26" FontSize="12"/>
                                    <TextBlock Text="{l:Tr Nav_NewCollection}"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{l:Tr Nav_Activity}" Style="{StaticResource Eyebrow}" Margin="10,18,0,6"/>
                            <RadioButton x:Name="NavPlaytime" Style="{StaticResource NavItem}" Click="NavPlaytime_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Width="26"/>
                                    <TextBlock Text="{l:Tr Nav_Playtime}"/>
                                </DockPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= Conteúdo ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de cima: transparente no topo da página, com fundo quando o conteúdo passa por baixo -->
                <Border x:Name="TopBarBackground" Grid.Row="0" Panel.ZIndex="1" Opacity="0" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                    </Border.Effect>
                </Border>
                <DockPanel Grid.Row="0" Margin="28,14,28,10" Panel.ZIndex="2">
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource RoundIconButton}"
                            Width="36" Height="36" FontSize="13" Content="&#xE72B;" Margin="0,0,12,0"
                            Click="Back_Click" ToolTip="{l:Tr BackTooltip}" Visibility="Collapsed"/>
                    <Grid DockPanel.Dock="Right" Width="300">
                        <TextBox x:Name="SearchBox" Style="{StaticResource RoundTextBox}" Padding="38,8,14,8"
                                 Tag="{l:Tr SearchHint}" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="15,0,0,0"
                                   HorizontalAlignment="Left" IsHitTestVisible="False"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                    </Grid>
                    <TextBlock x:Name="PageTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- As páginas aparecem aqui; ocupa também a zona da barra de cima para o banner ir até ao topo -->
                <ContentControl x:Name="ContentHost" Grid.Row="0" Grid.RowSpan="2" Focusable="False"
                                IsTabStop="False">
                    <TextBlock Text="{l:Tr Loading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Foreground="{StaticResource SubtleTextBrush}"/>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- Barra de ajuda do comando (estilo Big Picture): só aparece quando se usa o comando -->
        <Border x:Name="HintBar" VerticalAlignment="Bottom" Height="58" Background="#EB111215"
                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10">
            <DockPanel Margin="36,0,36,0">
                <StackPanel x:Name="HintsLeft" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"/>
                <StackPanel x:Name="HintsRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
