<UserControl x:Class="GameLauncher.Views.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameLauncher"
             xmlns:l="clr-namespace:GameLauncher.Localization">
    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinWidth" Value="170"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,0,40">

            <!-- ================= Banner ================= -->
            <Grid x:Name="Banner" Height="500" SizeChanged="Banner_SizeChanged">
                <Border x:Name="BannerArt" ClipToBounds="True" VerticalAlignment="Top">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <Border>
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#33000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.55"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <!-- Sempre a largura toda (sem cortes nos lados); em janelas muito largas corta só em baixo -->
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding BannerPath, Converter={StaticResource PathToImage}, ConverterParameter=1920}"
                                        Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top"/>
                        </Border.Background>
                    </Border>
                </Border>

                <StackPanel VerticalAlignment="Bottom" Margin="44,0,44,20">
                    <Grid HorizontalAlignment="Left" MaxWidth="520">
                        <Image Source="{Binding LogoPath, Converter={StaticResource PathToImage}, ConverterParameter=1000}"
                               MaxHeight="170" Stretch="Uniform" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="{Binding Name}" FontSize="50" FontWeight="Bold" TextWrapping="Wrap"
                                   Visibility="{Binding LogoPath, Converter={StaticResource NullToVis}}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" MinWidth="160"
                                Command="{x:Static local:AppCommands.PlayGame}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PlayButtonText}"/>
                            </StackPanel>
                        </Button>
                        <!-- Só aparece com o jogo aberto: fecha-o à força (como o "Parar" da Steam) -->
                        <Button Style="{StaticResource GlassButton}" Margin="10,0,0,0" Click="StopGame_Click"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:Tr Game_Stop}"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="14,0,0,0" ToolTip="{l:Tr FavoriteTooltip}"
                                Command="{x:Static local:AppCommands.ToggleFavorite}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
                                    <Setter Property="Content" Value="&#xEB51;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Content" Value="&#xEB52;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                Command="{x:Static local:AppCommands.OpenFolder}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:Tr Game_Folder}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                Visibility="{Binding StoreDetailsUri, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                Command="{x:Static local:AppCommands.OpenInStore}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Store}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlassButton}" Margin="10,0,0,0" Click="Customize_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:Tr Art_Customize}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlassButton}" Margin="10,0,0,0" Click="Remove_Click"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:Tr Game_Remove}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- O jogo fechou mas ficou um processo pendurado -->
                    <Border Visibility="{Binding IsStuck, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left"
                            Background="{StaticResource SurfaceStrongBrush}" CornerRadius="12" Padding="14,10" Margin="0,14,0,0" MaxWidth="640">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{l:Tr Game_StuckHint}" TextWrapping="Wrap" MaxWidth="580"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= Números ================= -->
            <WrapPanel Margin="44,16,32,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Game_PlaytimeLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding PlaytimeText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Game_LastLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Game_SizeLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Game_StoreLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Store}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ================= Coleções ================= -->
            <TextBlock Text="{l:Tr Nav_Collections}" Style="{StaticResource SectionTitle}" Margin="44,24,0,12"/>
            <WrapPanel x:Name="CollectionChips" Margin="44,0,32,0"/>
            <StackPanel Orientation="Horizontal" Margin="44,4,0,0">
                <TextBox x:Name="NewCollectionBox" Style="{StaticResource RoundTextBox}" Width="220" Padding="14,7" Tag="{l:Tr Game_NewCollectionHint}"
                         KeyDown="NewCollectionBox_KeyDown"/>
                <Button Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="AddCollection_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Tr Game_CreateAndAdd}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ================= Sessões ================= -->
            <TextBlock Text="{l:Tr Game_RecentSessions}" Style="{StaticResource SectionTitle}" Margin="44,30,0,12"/>
            <TextBlock x:Name="NoSessionsText" Margin="44,0,44,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="{l:Tr Game_NoSessions}"/>
            <ItemsControl x:Name="SessionsList" Margin="44,0,44,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,10" Margin="0,0,0,6"
                                MaxWidth="640" HorizontalAlignment="Left">
                            <DockPanel Width="600">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding When}" Foreground="{StaticResource SubtleTextBrush}"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
