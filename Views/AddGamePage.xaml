<UserControl x:Class="GameLauncher.Views.AddGamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GameLauncher.Localization">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="44,76,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{l:Tr Add_Title}" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="{l:Tr Add_Desc}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,6,0,6"/>

            <!-- Ficheiro -->
            <TextBlock Text="{l:Tr Add_File}" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Margin="10,0,0,0" Click="Browse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Tr Add_Browse}"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="PathBox" Style="{StaticResource RoundTextBox}" Padding="14,8"
                         Tag="{l:Tr Add_FileHint}" TextChanged="PathBox_TextChanged"/>
            </DockPanel>

            <!-- Nome -->
            <TextBlock Text="{l:Tr Add_Name}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource RoundTextBox}" Padding="14,8" Tag="{l:Tr Add_NameHint}"/>

            <!-- Loja / launcher -->
            <TextBlock Text="{l:Tr Add_Store}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="StoreBox" Style="{StaticResource RoundTextBox}" Padding="14,8" Tag="{l:Tr Add_StoreHint}"/>
            <WrapPanel x:Name="StoreChips" Margin="0,10,0,0"/>

            <!-- Argumentos -->
            <TextBlock Text="{l:Tr Add_Args}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ArgsBox" Style="{StaticResource RoundTextBox}" Padding="14,8" Tag="{l:Tr Add_ArgsHint}"/>

            <TextBlock x:Name="ErrorText" Foreground="#FFFFB4B4" Margin="0,16,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <Button Style="{StaticResource PrimaryButton}" Click="Add_Click" MinWidth="150">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                        <TextBlock Text="{l:Tr Add_Confirm}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GlassButton}" Margin="12,0,0,0" Content="{l:Tr Cancel}" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
