<UserControl x:Class="GameLauncher.Views.PlaytimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameLauncher"
             xmlns:l="clr-namespace:GameLauncher.Localization">
    <UserControl.Resources>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="250"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="44,76,40,40">
            <TextBlock Text="{l:Tr Nav_Playtime}" FontSize="34" FontWeight="Bold"/>
            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,24" TextWrapping="Wrap"
                       Text="{l:Tr Pt_Subtitle}"/>

            <!-- Resumo -->
            <WrapPanel>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Pt_Total}" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="TotalText" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="{l:Tr Pt_TotalSub}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Pt_Last7Upper}" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="WeekText" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="WeekSub" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Pt_MostPlayedUpper}" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="TopName" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TopTime" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Gráfico dos últimos 7 dias -->
            <TextBlock Text="{l:Tr Pt_Last7}" Style="{StaticResource SectionTitle}" Margin="0,22,0,14"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24,20" HorizontalAlignment="Left">
                <ItemsControl x:Name="DaysChart" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="70" Height="210" ToolTip="{Binding Tooltip}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding ValueText}" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4"/>
                                    <Border Width="36" Height="{Binding BarHeight}" CornerRadius="6,6,2,2"
                                            Background="#E6FFFFFF" Opacity="{Binding BarOpacity}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                           FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Jogos mais jogados -->
            <TextBlock Text="{l:Tr Pt_TopGames}" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>
            <ItemsControl x:Name="TopList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{x:Static local:AppCommands.OpenGame}" CommandParameter="{Binding Game}"
                                Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Foreground="{StaticResource TextBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                                            Padding="12,10" Width="760" BorderBrush="White" BorderThickness="0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Rank}" Width="30" FontSize="16"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource SubtleTextBrush}"/>
                                            <Border DockPanel.Dock="Left" Width="40" Height="60" CornerRadius="6"
                                                    Background="{StaticResource SurfaceStrongBrush}" ClipToBounds="True">
                                                <Image Source="{Binding Game.CoverPath, Converter={StaticResource PathToImage}, ConverterParameter=80}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Game.PlaytimeText}" Width="110"
                                                       TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Game.Name}" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Height="6" CornerRadius="3" Background="#26FFFFFF" Margin="0,8,0,0">
                                                    <Border Height="6" CornerRadius="3" Background="White"
                                                            HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoTopText" Visibility="Collapsed" Foreground="{StaticResource SubtleTextBrush}"
                       Text="{l:Tr Pt_None}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
